:root {
  --bg-color: #0a0a0a;
  --bg-primary: #111111;
  --bg-secondary: #1a1a1a;
  --text-primary: #ffffff;
  --text-secondary: #a1a1aa; /* Geist Gray */
  --text-muted: #71717a;
  --border-color: rgba(255, 255, 255, 0.1);
  --accent-color: #ffffff;
  --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
  --transition-speed: 0.3s;
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html, body {
  max-width: 100vw;
  overflow-x: hidden;
  background-color: var(--bg-color);
  background-image: radial-gradient(circle at 50% -20%, rgba(255, 255, 255, 0.08) 0%, transparent 50%);
  background-attachment: fixed;
  color: var(--text-primary);
  line-height: 1.6;
  font-family: var(--font-sans);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Eradicate scrollbar for minimalist look */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: var(--bg-color);
}
::-webkit-scrollbar-thumb {
  background: var(--text-muted);
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}

h1, h2, h3, h4, h5, h6 {
  color: var(--text-primary);
  line-height: 1.1;
  font-weight: 500;
  letter-spacing: -0.04em;
}

/* The Structural Overline */
.overline {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 21px;
}

.overline::after {
  content: '';
  height: 1px;
  flex: 1;
  background: var(--border-color);
  backdrop-filter: blur(0px); /* Hardware acceleration trick */
}

section {
  /* Fibonacci spacing: 55px, 89px, 144px */
  padding: 89px 34px;
  max-width: 1200px;
  margin: 0 auto;
  border-bottom: 1px solid var(--border-color);
}
section:last-child {
  border-bottom: none;
}

/* Premium Vercel Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 28px;
  background-color: var(--accent-color);
  color: #000000;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  border-radius: 9999px; /* Pill shape */
  border: 1px solid var(--accent-color);
  transition: all 0.2s ease;
  box-shadow: 0 4px 14px 0 rgba(255, 255, 255, 0.1);
}

.btn:hover {
  background-color: transparent;
  color: var(--accent-color);
  box-shadow: 0 6px 20px rgba(255, 255, 255, 0.15);
  transform: translateY(-1px);
}

.btnGhost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 28px;
  background-color: transparent;
  color: var(--text-primary);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  border-radius: 9999px;
  border: 1px solid var(--border-color);
  transition: all 0.2s ease;
}

.btnGhost:hover {
  background-color: rgba(255, 255, 255, 0.05);
  border-color: var(--text-primary);
}

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-color);
  padding: 21px 34px;
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--text-primary);
}

.nav-links {
  display: flex;
  gap: 34px;
}

.nav-links a {
  font-size: 0.85rem;
  font-weight: 400;
  color: var(--text-secondary);
  transition: color 0.2s;
}

.nav-links a:hover {
  color: var(--text-primary);
}

.footer {
  text-align: center;
  padding: 55px 34px;
  color: var(--text-muted);
  font-size: 0.85rem;
}
