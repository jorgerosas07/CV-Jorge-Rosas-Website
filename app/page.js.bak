"use client";

import { motion } from "framer-motion";
import Image from "next/image";
import styles from "./page.module.css";
import { cvData } from "../data";

// Elite Bezier Curve Transitions (No Springs)
const transition = { duration: 0.8, ease: [0.16, 1, 0.3, 1] };

const fadeInUp = {
  hidden: { opacity: 0, y: 20 },
  visible: { opacity: 1, y: 0, transition }
};

const staggerContainer = {
  hidden: { opacity: 0 },
  visible: {
    opacity: 1,
    transition: {
      staggerChildren: 0.1,
      delayChildren: 0.1
    }
  }
};

export default function Home() {
  return (
    <>
      {/* Hero Terminal */}
      <section id="about" className={styles.hero}>
        <div className={styles.heroGrid}>
          <motion.div 
            className={styles.heroContent}
            initial="hidden"
            animate="visible"
            variants={staggerContainer}
          >
            <motion.h1 variants={fadeInUp} className={styles.heroTitle}>
              {cvData.name}
            </motion.h1>
            <motion.p variants={fadeInUp} className={styles.heroSubtitle}>
              {cvData.hero.subtitle}
            </motion.p>
            <motion.div variants={fadeInUp} className={styles.heroActions}>
              <a href="#contact" className="btn">
                Initiate Contact
              </a>
              <a href={cvData.cv} download="Jorge_Rosas_CV.pdf" className="btnGhost">
                Download CV
              </a>
            </motion.div>
          </motion.div>

          <motion.div 
            className={styles.heroImageWrapper}
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}
          >
            <Image 
              src="/profile.jpg" 
              alt="Jorge Rosas" 
              fill 
              className={styles.heroImage} 
              priority
            />
          </motion.div>
        </div>
      </section>

      {/* Education Compartment */}
      <motion.section 
        id="education"
        initial="hidden"
        whileInView="visible"
        viewport={{ once: true, margin: "-10%" }}
        variants={staggerContainer}
      >
        <motion.div variants={fadeInUp} className="overline">
          // Academic Architecture
        </motion.div>
        <motion.div className={styles.grid} variants={staggerContainer}>
          {cvData.education.map((edu, index) => (
            <motion.div 
              key={index} 
              className={styles.bentoBox}
              variants={fadeInUp}
            >
              <div className={styles.bentoHeader}>
                <h3 className={styles.bentoTitle}>{edu.institution}</h3>
                <p className={styles.bentoSubtitle}>{edu.degree}</p>
                <span className={styles.bentoDate}>{edu.date}</span>
              </div>
              {edu.image && (
                <div className={styles.bentoImageContainer}>
                  <Image src={edu.image} alt={edu.institution} fill className={`${styles.bentoImage} ${edu.logo ? styles.bentoImageContain : ''}`} />
                </div>
              )}
              <ul className={styles.bentoBullets}>
                {edu.bullets.map((bullet, i) => (
                  <li key={i}>{bullet}</li>
                ))}
              </ul>
            </motion.div>
          ))}
        </motion.div>
      </motion.section>

      {/* Experience Matrix */}
      <motion.section 
        id="experience"
        initial="hidden"
        whileInView="visible"
        viewport={{ once: true, margin: "-10%" }}
        variants={staggerContainer}
      >
        <motion.div variants={fadeInUp} className="overline">
          // Professional Execution
        </motion.div>
        <motion.div className={styles.grid} variants={staggerContainer}>
          {cvData.experience.map((exp, index) => (
            <motion.div 
              key={index} 
              className={styles.bentoBox}
              variants={fadeInUp}
            >
              <div className={styles.bentoHeader}>
                <h3 className={styles.bentoTitle}>{exp.company}</h3>
                <p className={styles.bentoSubtitle}>{exp.role}</p>
                <span className={styles.bentoDate}>{exp.date}</span>
              </div>
              {exp.image && (
                <div className={styles.bentoImageContainer}>
                  <Image src={exp.image} alt={exp.company} fill className={`${styles.bentoImage} ${exp.logo ? styles.bentoImageContain : ''}`} />
                </div>
              )}
              <ul className={styles.bentoBullets}>
                {exp.bullets.map((bullet, i) => (
                  <li key={i}>{bullet}</li>
                ))}
              </ul>
              {exp.pitches && (
                <div className={styles.pitchDownloads}>
                  {exp.pitches.map((pitch, i) => (
                    <a href={pitch.url} download key={i} className={styles.downloadTag}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      {pitch.name}
                    </a>
                  ))}
                </div>
              )}
            </motion.div>
          ))}
        </motion.div>
      </motion.section>

      {/* Skills Matrix */}
      <motion.section 
        id="skills"
        initial="hidden"
        whileInView="visible"
        viewport={{ once: true, margin: "-10%" }}
        variants={staggerContainer}
      >
        <motion.div variants={fadeInUp} className="overline">
          // Core Capabilities
        </motion.div>
        <motion.div className={styles.skillsContainer} variants={staggerContainer}>
          {cvData.skills.map((skill, index) => (
            <motion.span 
              key={index} 
              className={styles.skillTag}
              variants={fadeInUp}
            >
              {skill}
            </motion.span>
          ))}
        </motion.div>
      </motion.section>

      {/* Achievements / Certifications */}
      <motion.section 
        id="achievements"
        initial="hidden"
        whileInView="visible"
        viewport={{ once: true, margin: "-10%" }}
        variants={staggerContainer}
      >
        <motion.div variants={fadeInUp} className="overline">
          // Milestones
        </motion.div>
        <motion.ul className={styles.simpleList} variants={staggerContainer}>
          {cvData.achievements.map((item, index) => (
            <motion.li key={index} variants={fadeInUp}>{item}</motion.li>
          ))}
        </motion.ul>
      </motion.section>

      {/* Contact Section */}
      <motion.section 
        id="contact" 
        className={styles.contactSection}
        initial="hidden"
        whileInView="visible"
        viewport={{ once: true, margin: "-10%" }}
        variants={staggerContainer}
      >
        <div className={styles.contactSplit}>
          <div className={styles.contactText}>
            <motion.div variants={fadeInUp} className="overline">
              // Communication Protocol
            </motion.div>
            <motion.h2 variants={fadeInUp}>Awaiting Input.</motion.h2>
            <motion.p variants={fadeInUp}>
              The architecture is established. My inbox is open for strategic partnerships and opportunities.
            </motion.p>
            <motion.div variants={fadeInUp} className={styles.heroActions}>
              <a href={`mailto:${cvData.email}`} className="btn">
                Send Email
              </a>
              <a href={cvData.linkedin} target="_blank" rel="noopener noreferrer" className="btn">
                LinkedIn
              </a>
            </motion.div>
          </div>
          <motion.div variants={fadeInUp} className={styles.contactImageWrapper}>
            <Image 
              src="/profile.jpg" 
              alt="Jorge Rosas" 
              fill 
              className={styles.contactImageLarge} 
            />
          </motion.div>
        </div>
      </motion.section>
    </>
  );
}
